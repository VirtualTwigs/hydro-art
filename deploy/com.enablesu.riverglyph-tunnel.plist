<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  TEMPLATE: install with `bash deploy/install-riverglyph.sh`, which fills in
  __REPO__, __HOME__ and __CLOUDFLARED__ for the current Mac. See deploy/CLOUDFLARE.md.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.enablesu.riverglyph-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>__CLOUDFLARED__</string>
    <string>tunnel</string>
    <string>--config</string>
    <string>__HOME__/.cloudflared/riverglyph.yml</string>
    <string>run</string>
    <string>riverglyph</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>__HOME__/Library/Logs/riverglyph-tunnel.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/Library/Logs/riverglyph-tunnel.log</string>
</dict>
</plist>

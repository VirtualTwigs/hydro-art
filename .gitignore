# Data artifacts (large, regenerable)
datasets/
cache/
output/
# also ignore `output`/`datasets` when migrated onto external storage (symlinks, not dirs)
output
datasets
logs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Coverage (regenerable; produced by tools/coverage_report.py)
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# OS / editors
.DS_Store
.idea/
.vscode/
.theia/

# Node (SVGO)
node_modules/

# Jupyter
.ipynb_checkpoints/
Untitled.ipynb

# Claude Code runtime
.claude/scheduled_tasks.lock
.claude/worktrees/

# Catalog runtime data (generated by tools/catalog.py)
catalog/

# Local staging dir for the demo container (copies of NAS-backed display SVGs)
deploy/output/

# riverglyph public demo credentials (deploy/gen-riverglyph-credentials.sh)
deploy/riverglyph.env

# Exception: commit the small landing-page WebPs start.html shows (built from
# committed market-analysis/thumbs + notebooks/figures; see deploy/CLOUDFLARE.md).
# Everything else under deploy/output/ (staged display SVGs) stays ignored.
!deploy/output/
deploy/output/*
!deploy/output/landing/
